{
  "name": "bluedots-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22" },
  "bin": { "journey": "./dist/cli/main.js" },
  "scripts": {
    "journey": "tsx src/cli/main.ts",
    "test": "vitest run",
    "test:stack": "vitest run --config vitest.stack.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
